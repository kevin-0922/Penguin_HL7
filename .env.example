# Copy to .env and choose a password before starting.
SQL_PASSWORD=change-this-password
SQL_DB=penguin
SQL_USERNAME=postgres
HTTP_PORT=3000
MLLP_PORT=4321
# Same-origin frontend requests work when accessing through the server IP or domain.
SERVER_CORS_ORIGIN=*
# Set the reachable external DICOM service URL to use DICOM forwarding.
Raccon_API_URL=http://host.docker.internal:8081
